<Window x:Class="CybersecurityChatBot1599.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-Bot Security Hub" Height="650" Width="720"
        WindowStartupLocation="CenterScreen" Background="#111116">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="ChatDisplayBox" 
                 Grid.Row="0"
                 FontFamily="Consolas" 
                 FontSize="13" 
                 Background="#16161E" 
                 Foreground="#00FF66" 
                 BorderBrush="#252530"
                 Padding="12" 
                 IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" 
                 TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputField" 
                     Grid.Column="0" 
                     Height="40" 
                     FontSize="14" 
                     Background="#20202A" 
                     Foreground="White" 
                     BorderBrush="#353545"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     KeyDown="InputField_KeyDown"/>

            <Button x:Name="SubmitButton" 
                    Grid.Column="1" 
                    Content="SEND" 
                    Margin="12,0,0,0" 
                    Background="#0066CC" 
                    Foreground="White" 
                    FontWeight="SemiBold"
                    Click="SubmitButton_Click"/>
        </Grid>
    </Grid>
</Window>