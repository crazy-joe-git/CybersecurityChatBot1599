<Window x:Class="CybersecurityChatBot1599.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-Bot Security Matrix" Height="700" Width="900"
        WindowStartupLocation="CenterScreen" Background="#0A0A0C">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111115" BorderBrush="#1C1C24" BorderThickness="0,0,1,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Conversations" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Border Background="#1C1C24" CornerRadius="8" Padding="10,8,10,8">
                        <TextBlock Text="🔍 Search historical threads..." Foreground="#626272" FontSize="12"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <Border Background="#1F1F29" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="36" Height="36" Fill="#8338EC"/>
                            <TextBlock Grid.Column="0" Text="🤖" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="E-BOT" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Assistant Engine" Foreground="#A0A0AB" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="Transparent" CornerRadius="12" Padding="12" Opacity="0.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="36" Height="36" Fill="#242526"/>
                            <TextBlock Grid.Column="0" Text="🔒" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Password Audit Logs" Foreground="White" FontSize="13"/>
                                <TextBlock Text="Completed 2 hours ago" Foreground="#A0A0AB" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A0A0C" Padding="20,15,20,15" BorderBrush="#1C1C24" BorderThickness="0,0,0,1" Margin="10,0,-10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Grid Margin="0,0,14,0">
                            <Ellipse Width="44" Height="44" Fill="#1F1F29"/>
                            <TextBlock Text="🤖" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CYBERSECURITY AWARENESS BOT" Foreground="White" FontWeight="Bold" FontSize="16"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Foreground="#10B981" FontSize="12" FontWeight="Medium" Width="82" Height="17"><Run Text="Active "/><LineBreak/><Run/></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                   
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="25,15,25,15">
                <ItemsControl x:Name="ChatItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="InlineAvatarGrid" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Bottom">
                                    <Ellipse Width="28" Height="28" Fill="#1F1F29"/>
                                    <TextBlock Text="🤖" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                                </Grid>

                                <Border x:Name="BubbleBorder" Grid.Column="1" CornerRadius="18" Padding="16,10,16,10" MaxWidth="480">
                                    <TextBlock Text="{Binding MessageText}"  Foreground="White" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" LineHeight="15"/>
                                </Border>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="BubbleBorder" Property="Background" Value="#8338EC"/>
                                    <Setter TargetName="InlineAvatarGrid" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="BubbleBorder" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="BubbleBorder" Property="Grid.ColumnSpan" Value="2"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsUser}" Value="False">
                                    <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Left"/>
                                    <Setter TargetName="BubbleBorder" Property="Background" Value="#242526"/>
                                    <Setter TargetName="InlineAvatarGrid" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="BubbleBorder" Property="Grid.Column" Value="1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#0A0A0C" Padding="20,15,20,20" BorderBrush="#1C1C24" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox" Grid.Column="0" Height="44" Background="#1C1C24" Foreground="White" 
                             BorderThickness="1" BorderBrush="#2C2C3A" Padding="16,0,16,0" FontSize="14" VerticalContentAlignment="Center"
                             CaretBrush="White" KeyDown="InputBox_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="22"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="85" Height="44" Margin="12,0,0,0" 
                            Background="#8338EC" Foreground="White" FontWeight="Bold" FontSize="13" 
                            BorderThickness="0" Click="SendButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="22"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>