<Window x:Class="CybersecurityChatBot1599.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-Bot Security Matrix" Height="750" Width="950"
        WindowStartupLocation="CenterScreen" Background="#0A0A0C">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding}" Margin="12,6,12,6"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#111115"/>
            <Setter Property="Foreground" Value="#A0A0AB"/>
            <Setter Property="BorderBrush" Value="#1C1C24"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <TabControl Background="#0A0A0C" BorderThickness="0,1,0,0" BorderBrush="#1C1C24">

        <TabItem Header="Matrix Core Chat" IsSelected="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#111115" BorderBrush="#1C1C24" BorderThickness="0,0,1,0" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Conversations" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                            <Border Background="#1C1C24" CornerRadius="8" Padding="10,8,10,8">
                                <TextBlock Text="Search historical threads..." Foreground="#626272" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <Border Background="#1F1F29" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="36" Height="36" Fill="#8338EC"/>
                                    <TextBlock Grid.Column="0" Text="Bot" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="E-BOT" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Assistant Engine" Foreground="#A0A0AB" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="Transparent" CornerRadius="12" Padding="12" Opacity="0.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="36" Height="36" Fill="#242526"/>
                                    <TextBlock Grid.Column="0" Text="Log" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Password Audit Logs" Foreground="White" FontSize="13"/>
                                        <TextBlock Text="Completed 2 hours ago" Foreground="#A0A0AB" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0A0A0C" Padding="20,15,20,15" BorderBrush="#1C1C24" BorderThickness="0,0,0,1" Margin="10,0,-10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Grid Margin="0,0,14,0">
                                    <Ellipse Width="44" Height="44" Fill="#1F1F29"/>
                                    <TextBlock Text="Bot" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CYBERSECURITY AWARENESS BOT" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Active" Foreground="#10B981" FontSize="12" FontWeight="Medium" Width="82" Height="17"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="25,15,25,15">
                        <ItemsControl x:Name="ChatItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid x:Name="InlineAvatarGrid" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Bottom">
                                            <Ellipse Width="28" Height="28" Fill="#1F1F29"/>
                                            <TextBlock Text="Bot" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                                        </Grid>

                                        <Border x:Name="BubbleBorder" Grid.Column="1" CornerRadius="18" Padding="16,10,16,10" MaxWidth="480">
                                            <TextBlock Text="{Binding MessageText}" Foreground="White" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" LineHeight="15"/>
                                        </Border>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="BubbleBorder" Property="Background" Value="#8338EC"/>
                                            <Setter TargetName="InlineAvatarGrid" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="BubbleBorder" Property="Grid.Column" Value="0"/>
                                            <Setter TargetName="BubbleBorder" Property="Grid.ColumnSpan" Value="2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUser}" Value="False">
                                            <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Left"/>
                                            <Setter TargetName="BubbleBorder" Property="Background" Value="#242526"/>
                                            <Setter TargetName="InlineAvatarGrid" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="BubbleBorder" Property="Grid.Column" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#0A0A0C" Padding="20,15,20,20" BorderBrush="#1C1C24" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InputBox" Grid.Column="0" Height="44" Background="#1C1C24" Foreground="White" 
                                     BorderThickness="1" BorderBrush="#2C2C3A" Padding="16,0,16,0" FontSize="14" VerticalContentAlignment="Center"
                                     CaretBrush="White" KeyDown="InputBox_KeyDown">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="22"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="85" Height="44" Margin="12,0,0,0" 
                                    Background="#8338EC" Foreground="White" FontWeight="Bold" FontSize="13" 
                                    BorderThickness="0" Click="SendButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="22"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Task Assistant">
            <Grid Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Create Security Task" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                    <TextBlock Text="Log internal items into the data engine" FontSize="12" Foreground="#626272" Margin="0,0,0,20"/>

                    <TextBlock Text="Task Title:" Foreground="#A0A0AB" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtTaskTitle" Height="38" Background="#111115" Foreground="White" BorderBrush="#1C1C24" BorderThickness="1" Padding="10,0,10,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Description / Actions required:" Foreground="#A0A0AB" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtTaskDesc" Height="80" Background="#111115" Foreground="White" BorderBrush="#1C1C24" BorderThickness="1" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,15"/>

                    <TextBlock Text="Reminder Window (e.g. 'In 2 hours'):" Foreground="#A0A0AB" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtTaskReminder" Height="38" Background="#111115" Foreground="White" BorderBrush="#1C1C24" BorderThickness="1" Padding="10,0,10,0" VerticalContentAlignment="Center" Margin="0,0,0,25"/>

                    <Button x:Name="btnAddTask" Content="Commit Task to Database" Height="42" Background="#8338EC" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Click="btnAddTask_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgTasks" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" 
                              Background="#111115" RowBackground="#1C1C24" AlternatingRowBackground="#111115" Foreground="White" 
                              BorderBrush="#1C1C24" HorizontalGridLinesBrush="#1C1C24" VerticalGridLinesBrush="#1C1C24">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1F1F29"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="Security Objective" Binding="{Binding Title}" Width="150"/>
                            <DataGridTextColumn Header="Description Detail" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Reminder Alert" Binding="{Binding Reminder}" Width="120"/>
                            <DataGridTextColumn Header="Done" Binding="{Binding IsComplete}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="btnMarkComplete" Content="Mark Completed" Width="140" Height="38" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="0,0,12,0" BorderThickness="0" Click="btnMarkComplete_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="btnDeleteTask" Content="Purge Record" Width="140" Height="38" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnDeleteTask_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Training Quiz" Background="#0A0A0C" Foreground="#10B981">
            <Grid Background="#0A0A0C" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#10B981" BorderThickness="0,0,0,2" Padding="0,0,0,10" Margin="0,0,0,15">
                    <Grid>
                        <TextBlock Text="SEC_TRAINING // TERMINAL CHALLENGE" Foreground="#10B981" FontSize="18" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtScore" Text="SCORE: 000" Foreground="#8338EC" FontSize="16" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#111115" BorderBrush="#8338EC" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <TextBlock x:Name="TxtQuestion" Text="Initializing training module..." Foreground="#FFFFFF" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="60"/>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnOpt0" Grid.Row="0" Grid.Column="0" Content="Option 0" Margin="5" Padding="10" Background="#0A0A0C" Foreground="#10B981" BorderBrush="#10B981" FontFamily="Consolas" Click="OptionButton_Click" Tag="0"/>
                    <Button x:Name="BtnOpt1" Grid.Row="0" Grid.Column="1" Content="Option 1" Margin="5" Padding="10" Background="#0A0A0C" Foreground="#10B981" BorderBrush="#10B981" FontFamily="Consolas" Click="OptionButton_Click" Tag="1"/>
                    <Button x:Name="BtnOpt2" Grid.Row="1" Grid.Column="0" Content="Option 2" Margin="5" Padding="10" Background="#0A0A0C" Foreground="#10B981" BorderBrush="#10B981" FontFamily="Consolas" Click="OptionButton_Click" Tag="2"/>
                    <Button x:Name="BtnOpt3" Grid.Row="1" Grid.Column="1" Content="Option 3" Margin="5" Padding="10" Background="#0A0A0C" Foreground="#10B981" BorderBrush="#10B981" FontFamily="Consolas" Click="OptionButton_Click" Tag="3"/>
                </Grid>

                <Border Grid.Row="3" Background="#111115" BorderBrush="#10B981" BorderThickness="1" Padding="10">
                    <Grid>
                        <TextBlock x:Name="TxtFeedback" Text="Select an answer to verify integrity." Foreground="#10B981" FontFamily="Consolas" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,120,0"/>
                        <Button x:Name="BtnNext" Content="NEXT >" Width="100" HorizontalAlignment="Right" Background="#8338EC" Foreground="#FFFFFF" BorderBrush="#8338EC" FontFamily="Consolas" FontWeight="Bold" Visibility="Collapsed" Click="BtnNext_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        
        <TabItem Header="Activity Audits">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="SYSTEM EVENT FORENSICS" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Audit stream mapping active. Log view layout ready for terminal operations." Foreground="#626272" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </TabItem>

    </TabControl>
</Window>